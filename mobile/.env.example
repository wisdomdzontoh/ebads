# Copy to `.env` and fill in. Expo inlines EXPO_PUBLIC_* variables at build time — there is
# no in-app settings field for either of these; the dispatcher never types them.

# Google Maps API key — drives Google Maps on Android (react-native-maps PROVIDER_GOOGLE), iOS,
# and the web static-map previews. Restrict this one to your Android app (package + SHA-1) and
# iOS bundle id; enable "Maps SDK for Android", "Maps SDK for iOS", "Maps Static API".
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Directions API key — the real road route for live in-app navigation
# (services/directions.ts). MUST be a key with Application restrictions set to None (or a
# second, unrestricted key) — an Android/iOS-app-restricted key rejects this call with
# REQUEST_DENIED, because it's a plain fetch() from JS, not a call through the native Maps SDK.
# See README.md's "Google Maps keys — you need TWO, not one" note if this is unset and live
# routing shows "Live route unavailable — REQUEST_DENIED...". Falls back to
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY above if left blank (works only if that key's Application
# restrictions are also None).
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=

# The EBADS engine's base URL, including the /api/v1 prefix. Point this at whichever
# deployment the build should talk to — e.g. https://ebads-engine-vyun.onrender.com/api/v1 for
# production, or http://<your LAN IP>:8000/api/v1 for a local engine during development. Set
# per EAS build profile (eas.json "env", or the EAS dashboard's per-environment variables) so a
# preview build and a production build can point at different engines without a code change.
EXPO_PUBLIC_ENGINE_BASE_URL=http://localhost:8000/api/v1
